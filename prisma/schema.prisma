generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// Better Auth tables (auto-generated, do not edit)
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  passkeys      Passkey[]
  members       Member[]
  campaigns     Campaign[]
  contacts      Contact[]
  lists         ContactList[]
  templates     EmailTemplate[]
  automations   Automation[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Passkey {
  id                  String    @id @default(cuid())
  name                String?
  publicKey           String
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID        String    @unique
  counter             Int       @default(0)
  deviceType          String
  backedUp            Boolean   @default(false)
  transports          String?
  aaguid              String?
  createdAt           DateTime  @default(now())

  @@map("passkey")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ============================================
// Organization (Better Auth org plugin)
// ============================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  metadata  String?

  // Plan & billing
  plan                PlanTier @default(FREE)
  emailsSentThisMonth Int      @default(0)
  emailsResetAt       DateTime @default(now())

  // WhatsApp (Baileys via Evolution API  or  Meta Cloud API)
  whatsappEnabled       Boolean        @default(false)
  whatsappMode          WhatsAppMode   @default(BAILEYS)
  whatsappPhone         String?        // Phone number linked (display only)
  // Baileys (Evolution API instance)
  evoInstanceName       String?        // Evolution API instance name
  evoInstanceStatus     String?        // "open" | "close" | "connecting"
  // Meta Cloud API
  metaWabaId            String?        // WhatsApp Business Account ID
  metaPhoneNumberId     String?        // Phone Number ID for sending
  metaAccessToken       String?        // Long-lived access token

  members     Member[]
  invitations Invitation[]
  campaigns   Campaign[]
  contacts    Contact[]
  lists       ContactList[]
  templates   EmailTemplate[]
  domains      SendingDomain[]
  automations  Automation[]
  senders      EmailSender[]
  capturePages CapturePage[]
  customFields CustomField[]
  integrationApiKeys IntegrationApiKey[]
  filonRecoveries FilonRecovery[]
  communicationTemplates CommunicationTemplate[]
  conversations Conversation[]
  messages CommunicationMessage[]
  webhooks WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  idempotencyRecords IdempotencyRecord[]
  auditLogs AuditLog[]
  feedback Feedback[]
  billingPayments BillingPayment[]

  @@map("organization")
}

enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

enum WhatsAppMode {
  BAILEYS
  META
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String

  @@map("invitation")
}

// ============================================
// Email Marketing — Contacts & Lists
// ============================================

model Contact {
  id              String        @id @default(cuid())
  email           String
  firstName       String?
  lastName        String?
  phone           String?
  metadata        Json?
  subscribed      Boolean       @default(true)
  bounceType      String?
  engagementScore Int           @default(0)
  lastEngagedAt   DateTime?
  source          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id])

  tags               ContactTag[]
  listMemberships    ContactListMember[]
  emailEvents        EmailEvent[]
  campaignRecipients CampaignRecipient[]
  filonRecoveries FilonRecovery[]
  conversations Conversation[]
  communicationMessages CommunicationMessage[]

  @@unique([email, organizationId])
  @@index([organizationId, subscribed])
  @@index([organizationId, createdAt])
  @@index([engagementScore])
  @@map("contact")
}

model ContactTag {
  id        String  @id @default(cuid())
  name      String
  color     String  @default("#6B7280")
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([name])
  @@map("contact_tag")
}

model ContactList {
  id             String              @id @default(cuid())
  name           String
  description    String?
  type           String              @default("manual")
  dynamicFilter  Json?
  contactCount   Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id])

  members        ContactListMember[]
  campaigns      Campaign[]

  @@index([organizationId])
  @@map("contact_list")
}

model ContactListMember {
  id            String      @id @default(cuid())
  contactId     String
  contact       Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactListId String
  contactList   ContactList @relation(fields: [contactListId], references: [id], onDelete: Cascade)
  addedAt       DateTime    @default(now())

  @@unique([contactId, contactListId])
  @@map("contact_list_member")
}

// ============================================
// Email Marketing — Campaigns
// ============================================

model Campaign {
  id             String         @id @default(cuid())
  name           String
  subject        String?
  subjectB       String?
  previewText    String?
  fromName       String?
  fromEmail      String?
  replyTo        String?
  htmlContent    String?
  textContent    String?
  whatsappImageUrl  String?
  whatsappImageName String?
  templateId     String?
  template       EmailTemplate? @relation(fields: [templateId], references: [id])
  status         CampaignStatus @default(DRAFT)
  channel        CommunicationChannel @default(EMAIL)
  type           CampaignType   @default(REGULAR)
  scheduledAt    DateTime?
  sentAt         DateTime?
  completedAt    DateTime?
  abTestWinner   String?
  abTestSplit    Int            @default(50)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  contactListId  String?
  contactList    ContactList?   @relation(fields: [contactListId], references: [id])

  recipients     CampaignRecipient[]
  analytics      CampaignAnalytics?

  @@index([organizationId, status])
  @@index([scheduledAt])
  @@map("campaign")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
}

enum CampaignType {
  REGULAR
  AB_TEST
  AUTOMATED
}

model CampaignRecipient {
  id             String    @id @default(cuid())
  campaignId     String
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  variant        String    @default("A")
  sentAt         DateTime?
  deliveredAt    DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  bouncedAt      DateTime?
  complainedAt   DateTime?
  unsubscribedAt DateTime?

  events         EmailEvent[]

  @@unique([campaignId, contactId])
  @@index([campaignId, sentAt])
  @@index([contactId])
  @@map("campaign_recipient")
}

model CampaignAnalytics {
  id                String   @id @default(cuid())
  campaignId        String   @unique
  campaign          Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  totalSent         Int      @default(0)
  totalDelivered    Int      @default(0)
  totalOpened       Int      @default(0)
  uniqueOpens       Int      @default(0)
  totalClicked      Int      @default(0)
  uniqueClicks      Int      @default(0)
  totalBounced      Int      @default(0)
  totalComplaints   Int      @default(0)
  totalUnsubscribed Int      @default(0)
  openRate          Float    @default(0)
  clickRate         Float    @default(0)
  bounceRate        Float    @default(0)
  updatedAt         DateTime @updatedAt

  @@map("campaign_analytics")
}

// ============================================
// Email Events (tracking)
// ============================================

model EmailEvent {
  id          String         @id @default(cuid())
  type        EmailEventType
  contactId   String
  contact     Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  recipientId String?
  recipient   CampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([contactId, type])
  @@index([recipientId, type])
  @@index([createdAt])
  @@map("email_event")
}

enum EmailEventType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED_SOFT
  BOUNCED_HARD
  COMPLAINED
  UNSUBSCRIBED
}

// ============================================
// Email Templates
// ============================================

model EmailTemplate {
  id             String       @id @default(cuid())
  name           String
  description    String?
  htmlContent    String
  textContent    String?
  whatsappImageUrl  String?
  whatsappImageName String?
  thumbnailUrl   String?
  category       String       @default("custom")
  channel        CommunicationChannel @default(EMAIL)
  isPublic       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  campaigns      Campaign[]

  @@map("email_template")
}

// ============================================
// Sending Domains
// ============================================

model SendingDomain {
  id              String       @id @default(cuid())
  domain          String
  resendDomainId  String?
  status          String       @default("not_started")
  verified        Boolean      @default(false)
  spfRecord       String?
  spfStatus       String?
  dkimRecord      String?
  dkimName        String?
  dkimStatus      String?
  dmarcRecord     String?
  region          String       @default("us-east-1")
  verifiedAt      DateTime?
  createdAt       DateTime     @default(now())

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([domain, organizationId])
  @@map("sending_domain")
}

// ============================================
// Custom Fields (contact metadata definitions)
// ============================================

model CustomField {
  id             String       @id @default(cuid())
  name           String
  label          String
  type           String       @default("text")
  required       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([name, organizationId])
  @@map("custom_field")
}

// ============================================
// Email Senders
// ============================================

model EmailSender {
  id             String       @id @default(cuid())
  name           String
  email          String
  replyTo        String?
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([email, organizationId])
  @@map("email_sender")
}

// ============================================
// Capture Pages (subscriber forms)
// ============================================

model CapturePage {
  id             String       @id @default(cuid())
  name           String
  slug           String
  description    String?
  published      Boolean      @default(false)
  fields         Json         @default("[{\"name\":\"email\",\"type\":\"email\",\"required\":true,\"label\":\"Email\"}]")
  successMessage String       @default("Merci ! Vous etes inscrit.")
  buttonLabel    String       @default("S'inscrire")
  totalViews     Int          @default(0)
  uniqueViews    Int          @default(0)
  conversions    Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dailyStats     CapturePageDailyStat[]

  @@unique([slug, organizationId])
  @@map("capture_page")
}

model CapturePageDailyStat {
  id            String      @id @default(cuid())
  date          DateTime    @db.Date
  views         Int         @default(0)
  uniqueViews   Int         @default(0)
  conversions   Int         @default(0)

  capturePageId String
  capturePage   CapturePage @relation(fields: [capturePageId], references: [id], onDelete: Cascade)

  @@unique([capturePageId, date])
  @@map("capture_page_daily_stat")
}

// ============================================
// Automations / Workflows
// ============================================

model Automation {
  id             String            @id @default(cuid())
  name           String
  description    String?
  trigger        AutomationTrigger
  triggerConfig  Json?
  status         AutomationStatus  @default(DRAFT)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id])

  steps          AutomationStep[]

  @@index([organizationId, status])
  @@map("automation")
}

enum AutomationTrigger {
  SUBSCRIBER_ADDED
  TAG_ADDED
  CAMPAIGN_OPENED
  LINK_CLICKED
  DATE_BASED
  CUSTOM_EVENT
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model AutomationStep {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  type         String
  config       Json
  position     Int
  createdAt    DateTime   @default(now())

  @@index([automationId, position])
  @@map("automation_step")
}

// ============================================
// Integrations — Filon recovery
// ============================================

model IntegrationApiKey {
  id             String              @id @default(cuid())
  provider       IntegrationProvider @default(FILON)
  environment    ApiKeyEnvironment   @default(LIVE)
  name           String
  defaultEmailSenderId String?
  keyHash        String              @unique
  keyPrefix      String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, provider, revokedAt])
  @@map("integration_api_key")
}

enum IntegrationProvider {
  MAILPULSE
  FILON
}

enum ApiKeyEnvironment {
  LIVE
  TEST
}

enum CommunicationChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum RecipientType {
  EMAIL
  PHONE
}

enum MessageContentType {
  TEXT
  TEMPLATE
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageOrigin {
  API
  PLATFORM
  CAMPAIGN
}

enum MessageStatus {
  QUEUED
  RETRYING
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
  TEMPLATE_REQUIRED
}

enum TemplateStatus {
  DRAFT
  APPROVED
  PENDING_REVIEW
  REJECTED
  ARCHIVED
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
}

model CommunicationTemplate {
  id                  String               @id @default(cuid())
  templateKey         String
  name                String
  description         String?
  channel             CommunicationChannel
  locale              String               @default("fr")
  contentType         MessageContentType   @default(TEMPLATE)
  subject             String?
  body                String
  variables           Json?
  providerTemplateId  String?
  status              TemplateStatus       @default(DRAFT)
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  messages            CommunicationMessage[]

  @@unique([organizationId, templateKey, locale, channel])
  @@index([organizationId, channel, status])
  @@map("communication_template")
}

model Conversation {
  id                     String               @id @default(cuid())
  channel                CommunicationChannel
  recipientType          RecipientType
  recipientValue         String
  status                 ConversationStatus   @default(OPEN)
  lastInboundAt          DateTime?
  serviceWindowExpiresAt DateTime?
  closedAt               DateTime?
  metadata               Json?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  organizationId         String
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId              String?
  contact                Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)

  messages               CommunicationMessage[]

  @@index([organizationId, channel, status])
  @@index([organizationId, recipientValue])
  @@map("conversation")
}

model CommunicationMessage {
  id                    String               @id @default(cuid())
  channel               CommunicationChannel
  direction             MessageDirection     @default(OUTBOUND)
  origin                MessageOrigin?
  recipientType         RecipientType
  recipientValue        String
  contentType           MessageContentType
  text                  String?
  templateKey           String?
  locale                String?
  variables             Json?
  metadata              Json?
  externalUserId        String?
  externalEventId       String?
  externalTenantId      String?
  idempotencyKey        String?
  providerMessageId     String?
  status                MessageStatus        @default(QUEUED)
  errorCode             String?
  errorMessage          String?
  queuedAt              DateTime             @default(now())
  sentAt                DateTime?
  deliveredAt           DateTime?
  readAt                DateTime?
  failedAt              DateTime?
  cancelledAt           DateTime?
  retryCount            Int                  @default(0)
  nextRetryAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  organizationId        String
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId             String?
  contact               Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversationId        String?
  conversation          Conversation?         @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  templateId            String?
  template              CommunicationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  webhookDeliveries     WebhookDelivery[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, channel, createdAt])
  @@index([organizationId, origin, createdAt])
  @@index([conversationId, createdAt])
  @@index([externalEventId])
  @@map("communication_message")
}

model WebhookEndpoint {
  id             String              @id @default(cuid())
  name           String
  url            String
  events         String[]
  signingSecret  String
  secretHash     String
  secretPreview  String
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  deliveries     WebhookDelivery[]

  @@index([organizationId, active])
  @@map("webhook_endpoint")
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  eventId        String
  eventType      String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  lastError      String?
  deliveredAt    DateTime?
  nextRetryAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  endpointId     String
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  messageId      String?
  message        CommunicationMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([endpointId, eventId])
  @@index([organizationId, status, createdAt])
  @@map("webhook_delivery")
}

model IdempotencyRecord {
  id             String       @id @default(cuid())
  key            String
  method         String
  path           String
  requestHash    String
  statusCode     Int
  responseBody   Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key, method, path])
  @@index([organizationId, createdAt])
  @@map("idempotency_record")
}

model AuditLog {
  id             String       @id @default(cuid())
  actorType      String
  actorId        String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_log")
}

model FilonRecovery {
  id                 String              @id @default(cuid())
  filonOpportunityId String
  externalWorkspaceId String?
  externalUserId      String?
  opportunityTitle   String
  amountDue          Decimal             @db.Decimal(12, 2)
  currency           String
  dueDate            DateTime
  clientName         String
  clientEmail        String
  clientPhone        String?
  status             FilonRecoveryStatus @default(PENDING)
  lastReminderAt     DateTime?
  nextReminderAt     DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId          String
  contact            Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)

  steps              FilonRecoveryStep[]

  @@unique([organizationId, filonOpportunityId])
  @@index([organizationId, status])
  @@index([nextReminderAt])
  @@map("filon_recovery")
}

enum FilonRecoveryStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  FAILED
}

model FilonRecoveryStep {
  id               String              @id @default(cuid())
  recoveryId       String
  recovery         FilonRecovery       @relation(fields: [recoveryId], references: [id], onDelete: Cascade)
  position         Int
  offsetDays       Int
  channel          RecoveryStepChannel
  templateKey      String
  subject          String?
  body             String
  scheduledAt      DateTime
  status           RecoveryStepStatus  @default(PREPARED)
  errorMessage     String?
  sentAt           DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([recoveryId, position])
  @@index([recoveryId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("filon_recovery_step")
}

enum RecoveryStepChannel {
  EMAIL
  WHATSAPP
  HUMAN_ACTION
}

enum RecoveryStepStatus {
  PENDING
  PREPARED
  SENT
  SKIPPED
  FAILED
  CANCELLED
}

enum FeedbackType {
  BUG
  IDEA
  OTHER
}

enum FeedbackPriority {
  LOW
  MEDIUM
  HIGH
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  DONE
  DISMISSED
}

model Feedback {
  id             String           @id @default(cuid())
  type           FeedbackType
  priority       FeedbackPriority @default(MEDIUM)
  status         FeedbackStatus   @default(NEW)
  message        String
  context        String?
  pageTitle      String?
  browser        String?
  viewport       String?
  screenshotUrl  String?
  canContactBack Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?

  @@index([organizationId, status, createdAt])
  @@index([type, priority])
  @@map("feedback")
}

enum BillingPaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

model BillingPayment {
  id                String               @id @default(cuid())
  provider          String               @default("PAYSTACK")
  reference         String               @unique
  authorizationUrl  String?
  accessCode        String?
  plan              PlanTier
  amount            Int
  currency          String               @default("XOF")
  status            BillingPaymentStatus @default(PENDING)
  providerStatus    String?
  paidAt            DateTime?
  rawResponse        Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organizationId    String
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId            String?

  @@index([organizationId, status, createdAt])
  @@map("billing_payment")
}
