# ============================================
# Database (PostgreSQL)
# ============================================
DATABASE_URL="postgresql://mailpulse:mailpulse@localhost:5432/mailpulse?schema=public"

# ============================================
# Better Auth
# ============================================
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="your-secret-key-min-32-characters-long"
BETTER_AUTH_API_KEY=""
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
ADMIN_EMAILS=""

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================================
# Convex
# ============================================
NEXT_PUBLIC_CONVEX_URL=""

# ============================================
# Resend (Email)
# ============================================
RESEND_API_KEY=""
RESEND_FROM_EMAIL="MailPulse <noreply@yourdomain.com>"
RESEND_WEBHOOK_SECRET=""

# ============================================
# Cloudflare R2 (Storage)
# ============================================
CLOUDFLARE_R2_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET="mailpulse"
CLOUDFLARE_R2_PUBLIC_URL="https://assets.yourdomain.com"

# ============================================
# Tracking
# ============================================
TRACKING_SECRET="your-tracking-secret-min-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# Orange SMS CÃ´te d'Ivoire
# ============================================
# Activez uniquement après le provisionnement complet Orange. À false, les previews ne requièrent aucune variable Orange.
ORANGE_SMS_ENABLED="false"
ORANGE_SMS_CLIENT_ID=""
ORANGE_SMS_CLIENT_SECRET=""
ORANGE_SMS_OWNER_ORGANIZATION_ID=""
# Numéro E.164 ivoirien réellement autorisé par le contrat Orange, jamais +2250000.
ORANGE_SMS_SENDER_ADDRESS=""
# Doit être true avec ORANGE_SMS_ENABLED=true, après confirmation de ce numéro dans le portail Orange.
ORANGE_SMS_SENDER_CONFIRMED="false"
# Les accusés restent désactivés tant que l'abonnement Orange et cette URL ne sont pas confirmés.
ORANGE_SMS_DELIVERY_RECEIPTS_CONFIRMED="false"
# URL HTTPS enregistrée manuellement dans le portail Orange : https://app.example.com/api/webhooks/sms/orange?token=...
ORANGE_SMS_DELIVERY_RECEIPT_CALLBACK_URL=""
# Jeton URL-safe aléatoire de 32 à 128 caractères, identique au paramètre token de l'URL de rappel.
ORANGE_SMS_WEBHOOK_TOKEN=""

# Planificateurs et routes cron
# Secret aléatoire d'au moins 32 caractères. Utilisez exactement la même valeur dans l'environnement de déploiement et le secret GitHub Actions CRON_SECRET.
CRON_SECRET=""

# ============================================
# Paystack Billing
# ============================================
PAYSTACK_SECRET_KEY="sk_test_xxx"

# ============================================
# Applications externes
# ============================================
# Clé Base64 de 32 octets pour chiffrer les identifiants des applications clientes.
# Génération : pnpm exec node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
EXTERNAL_APPLICATION_KEK=""
# Compatibilité temporaire des anciennes routes sans clé dans l'URL. Facultatif.
LEGACY_EXTERNAL_APPLICATION_KEY=""
