# ============================================
# Database (PostgreSQL)
# ============================================
DATABASE_URL="postgresql://mailpulse:mailpulse@localhost:5432/mailpulse?schema=public"

# ============================================
# Better Auth
# ============================================
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="your-secret-key-min-32-characters-long"
BETTER_AUTH_API_KEY=""
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
ADMIN_EMAILS=""

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================================
# Convex
# ============================================
NEXT_PUBLIC_CONVEX_URL=""

# ============================================
# Resend (Email)
# ============================================
RESEND_API_KEY=""
RESEND_FROM_EMAIL="MailPulse <noreply@yourdomain.com>"
RESEND_WEBHOOK_SECRET=""

# ============================================
# Cloudflare R2 (Storage)
# ============================================
CLOUDFLARE_R2_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET="mailpulse"
CLOUDFLARE_R2_PUBLIC_URL="https://assets.yourdomain.com"

# ============================================
# Tracking
# ============================================
TRACKING_SECRET="your-tracking-secret-min-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# Paystack Billing
# ============================================
PAYSTACK_SECRET_KEY="sk_test_xxx"
